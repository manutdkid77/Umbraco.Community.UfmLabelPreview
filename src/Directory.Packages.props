<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supported range for consumers: built against the 17.0.0 floor, capped below 18 (v18 drops kebab-case filters; separate plan). -->
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.0.0, 18.0.0)" />
  </ItemGroup>

</Project>
