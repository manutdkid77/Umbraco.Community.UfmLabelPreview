<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supported range for consumers: no C# code; JS verified against 17.8.0 / 18.2.1 / 19.0.0-rc1. -->
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.0.0, 20.0.0)" />
  </ItemGroup>

</Project>
