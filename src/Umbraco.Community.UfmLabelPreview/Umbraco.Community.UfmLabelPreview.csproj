<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Serve wwwroot/App_Plugins/... at /App_Plugins/... (not /_content/<id>/...) -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Umbraco.Community.UfmLabelPreview</Product>
    <PackageId>Umbraco.Community.UfmLabelPreview</PackageId>
    <!-- Keep in step with umbraco-package.json "version" and CHANGELOG.md -->
    <Version>1.0.0</Version>
    <Title>Umbraco.Community.UfmLabelPreview</Title>
    <Description>Live preview of block labels (Umbraco Flavored Markdown) while configuring Block List, Block Grid, Block RTE and Block Single types, using mock data. Configuration-time aid only; no content lookups, no telemetry.</Description>
    <!-- "umbraco-marketplace" is what gets the package listed on the Umbraco Marketplace -->
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;backoffice;block-list;block-grid;ufm</PackageTags>
    <Authors>Nathaniel Nunes</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Nathaniel Nunes</Copyright>
    <PackageProjectUrl>https://github.com/manutdkid77/Umbraco.Community.UfmLabelPreview</PackageProjectUrl>
    <RepositoryUrl>https://github.com/manutdkid77/Umbraco.Community.UfmLabelPreview</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>See https://github.com/manutdkid77/Umbraco.Community.UfmLabelPreview/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Writes the repository URL and commit into the nuspec; no symbols package because there is no C# code. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Versions live in src/Directory.Packages.props; no C# code, the reference only limits consumers to Umbraco 17-19. -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\README_nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\docs\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
