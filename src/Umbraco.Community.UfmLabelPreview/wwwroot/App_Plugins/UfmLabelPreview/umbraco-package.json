{
  "id": "Umbraco.Community.UfmLabelPreview",
  "name": "Umbraco.Community.UfmLabelPreview",
  "version": "0.2.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "workspaceView",
      "alias": "UfmLabelPreview.WorkspaceView.BlockType.LabelPreview",
      "name": "UFM Label Preview - Block Type Workspace View",
      "element": "/App_Plugins/UfmLabelPreview/label-preview-view.element.js",
      "weight": 900,
      "meta": {
        "label": "Label preview",
        "pathname": "label-preview",
        "icon": "icon-eye"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.WorkspaceAlias",
          "oneOf": [
            "Umb.Workspace.BlockListType",
            "Umb.Workspace.BlockGridType",
            "Umb.Workspace.BlockRteType",
            "Umb.Workspace.BlockSingleType"
          ]
        }
      ]
    }
  ]
}
